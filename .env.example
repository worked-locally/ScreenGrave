# Copy this file to .env and fill it in:  cp .env.example .env
# .env is gitignored and never copied into the image.

# Required: TMDB "API Read Access Token" (the long one that starts with eyJ)
TMDB_TOKEN=

# Optional: Trakt sync (Client ID from https://developer.trakt.tv/apps)
TRAKT_CLIENT_ID=

# Sign-in. Leave these out to choose in the app on first run: a PIN, a password, or no sign-in.
# Set APP_PASSWORD only if you'd rather manage the password here (the app can't change it then).
# APP_PASSWORD=
# AUTH_DISABLED=true        # turns sign-in off completely (trusted networks only)

# Optional: only for the redirect sign-in to Trakt. Normally leave it out.
# TRAKT_REDIRECT_URI=https://screeng.example.com/api/trakt/callback
