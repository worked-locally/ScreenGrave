# Copy this file to .env and fill it in:  cp .env.example .env
# .env is gitignored and never copied into the image.

# Required: TMDB "API Read Access Token" (the long one that starts with eyJ)
TMDB_TOKEN=

# Sign-in. Leave APP_PASSWORD empty to turn sign-in off (only do that on a trusted network).
APP_USERNAME=
APP_PASSWORD=

# Optional: Trakt sync (Client ID from https://developer.trakt.tv/apps)
TRAKT_CLIENT_ID=

# Optional: normally worked out automatically from the address you browse on.
# Set it only if Trakt sign-in sends you to the wrong address.
# TRAKT_REDIRECT_URI=https://screeng.example.com/api/trakt/callback
